{
  "name": "nexus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "node scripts/guard-production.mjs && wrangler deploy",
    "preview:staging": "npm run build && wrangler preview",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.dev.jsonc",
    "dev:full": "npm run build && npm run db:migrate:local && wrangler dev --config wrangler.dev.jsonc",
    "dev:demo": "NEXUS_BUNDLE=demo vite",
    "build:demo": "tsc --noEmit && NEXUS_BUNDLE=demo vite build"
  },
  "dependencies": {
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
