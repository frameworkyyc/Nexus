{
  // Local test of the PUBLIC VIEW-ONLY site (never deployed): the public API (NEXUS_ENV "public") over the same local database that
  // `npm run dev:full` uses, with no sign-in. Run `npm run build` and `npm run db:migrate:local` first, then:
  //   npx wrangler dev --config wrangler.public.jsonc --port 8788
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-public-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "NEXUS_ENV": "public" },
  "d1_databases": [{ "binding": "DB", "database_name": "nexus-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }]
}
