{
  // Local test of the PUBLIC VIEW-ONLY site (never deployed): NEXUS_ENV "public", reading the sanitized snapshot from a local R2 bucket. Like production, it
  // has NO database binding. Publish a snapshot first by running the local app (`wrangler dev --config wrangler.dev.jsonc`) and making any change.
  // Then, after `npm run build`:
  //   npx wrangler dev --config wrangler.public.jsonc --port 8788
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-public-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "vars": { "NEXUS_ENV": "public" },
  "r2_buckets": [{ "binding": "PUBLIC_SNAPSHOT", "bucket_name": "nexus-public-snapshot" }]
}
