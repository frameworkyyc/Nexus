{
  // Static single-page app served by Cloudflare Workers assets.
  // `name` must match the Worker connected to GitHub in the Cloudflare dashboard.
  // The Worker currently builds from the `staging` branch; `main` stays the stable branch.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Required by `wrangler preview` (Worker Previews for non-production branch builds).
  "previews": {}
}
