{
  // Nexus — ONE Cloudflare Worker (`nexus`), two branches, same architecture as Studio29 and LaNoir.
  //
  //   Branch    Cloudflare build command   Deploy command         Served at
  //   main      npm run build              npx wrangler deploy    nexus.frameworktools.ca          (production)
  //   staging   npm run build              npx wrangler preview   staging.nexus.frameworktools.ca  (Worker Preview)
  //
  // `wrangler preview` publishes an isolated Preview named after the git branch ("staging"). It never
  // creates a Worker version or deployment on production, so staging cannot overwrite `nexus`.
  // Domains are managed in the Cloudflare dashboard (not in this file), so a deploy never moves them.
  //
  // The Worker serves only /api/* (saved data); static files are served by Cloudflare's asset layer.
  // Saved data needs three things, all supplied per environment — see docs/OPERATIONS.md:
  //   1. a D1 database binding named DB,
  //   2. Cloudflare Access in front of the site, and
  //   3. ACCESS_TEAM_DOMAIN and ACCESS_AUD so the Worker can verify Access's signed token itself.
  // Until all three exist the API refuses to serve data and the app shows demonstration data only. Production
  // intentionally has none of them yet: production gets its OWN database, bindings and Access policy when it is promoted.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  // Safety net: `wrangler deploy` builds dist/ itself on a clean clone.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    // Unknown paths return index.html so React Router handles direct URLs and refreshes.
    "not_found_handling": "single-page-application",
    // Only API calls reach the Worker.
    "run_worker_first": ["/api/*"]
  },
  "vars": { "NEXUS_ENV": "production" },
  // Staging (Worker Preview) settings. Never point these at the production database.
  "previews": {
    "vars": {
      "NEXUS_ENV": "staging",
      // From Zero Trust → Access → Applications → (your app). Fill in after creating the Access application.
      "ACCESS_TEAM_DOMAIN": "",
      "ACCESS_AUD": ""
    }
    // Add after creating the STAGING database (docs/OPERATIONS.md, step 2):
    // "d1_databases": [{ "binding": "DB", "database_name": "nexus-staging", "database_id": "<STAGING_DATABASE_ID>" }]
  }
}
