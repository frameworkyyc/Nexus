{
  // Nexus — ONE Cloudflare Worker (`nexus`), two branches, same architecture as Studio29 and LaNoir.
  //
  //   Branch    Cloudflare build command   Deploy command         Served at
  //   main      npm run build              npx wrangler deploy    nexus.frameworktools.ca          (public demo, fictional data)
  //   staging   npm run build              npx wrangler preview   staging.nexus.frameworktools.ca  (Worker Preview)
  //
  // `wrangler preview` publishes an isolated Preview named after the git branch ("staging"). It never
  // creates a Worker version or deployment on production, so staging cannot overwrite `nexus`.
  // Domains are managed in the Cloudflare dashboard (not in this file), so a deploy never moves them.
  //
  // The Worker serves only /api/* (saved data); static files are served by Cloudflare's asset layer.
  // Saved data needs three things, all supplied per environment — see docs/OPERATIONS.md:
  //   1. a D1 database binding named DB,
  //   2. Cloudflare Access in front of the site, and
  //   3. ACCESS_TEAM_DOMAIN and ACCESS_AUD so the Worker can verify Access's signed token itself.
  // Until all three exist the API refuses to serve data and the app shows demonstration data only. Production
  // intentionally has none of them yet: production gets its OWN database, bindings and Access policy when it is promoted.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  // Safety net: `wrangler deploy` builds dist/ itself on a clean clone.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    // Unknown paths return index.html so React Router handles direct URLs and refreshes.
    "not_found_handling": "single-page-application",
    // Only API calls reach the Worker.
    "run_worker_first": ["/api/*"]
  },
  // The main deployment is currently the PUBLIC DEMO: NEXUS_ENV "demo" switches the API off entirely (src/worker/api.ts), and there is no
  // database binding or Access config here. When the main domain becomes the authenticated app, set this back to "production" and
  // move the demo to demo.nexus.frameworktools.ca (docs/DEPLOYMENT.md).
  "vars": { "NEXUS_ENV": "demo" },
  // Staging (Worker Preview) settings. Never point these at the production database.
  "previews": {
    "vars": {
      "NEXUS_ENV": "staging",
      // From Zero Trust → Access → Applications → (your app). Fill in after creating the Access application.
      "ACCESS_TEAM_DOMAIN": "https://frameworkco-admin.cloudflareaccess.com",
      "ACCESS_AUD": "4026513ce48dab9a17746204c3dff5e2a86400a7db34632ff4f701d805318a2f",
      // First administrator (docs/MATERIALS.md): used only while no administrator exists, and only for a request Cloudflare Access has verified.
      "INITIAL_ADMIN_EMAIL": "hello@frameworkco.ca",
      // Sign-in: "access" (Cloudflare Access, the default), "both" (accept either: Access AND WorkOS, while WorkOS is verified; Access stays on), or "workos" (WorkOS AuthKit only).
      // "both" on staging while WorkOS is verified (docs/AUTH.md). Roll back by setting "access". WorkOS needs WORKOS_CLIENT_ID and APP_BASE_URL here, and the secrets WORKOS_API_KEY and SESSION_PEPPER
      // (npx wrangler preview secret put ... --name staging). Never put the API key or pepper in this file.
      "AUTH_PROVIDER": "both",
      // WorkOS (Nexus Staging environment). Public, non-secret. WORKOS_API_KEY and SESSION_PEPPER are Cloudflare secrets, never here (docs/AUTH.md).
      "WORKOS_CLIENT_ID": "client_01M6BZ6XE05EJFK8663JRZ14ES",
      "APP_BASE_URL": "https://staging.nexus.frameworktools.ca"
    },
    // The STAGING database only. Never put nexus-production here. Migrations 0001-0007 are applied to it (docs/OPERATIONS.md).
    "d1_databases": [{ "binding": "DB", "database_name": "nexus-staging", "database_id": "8efc35c6-e125-4c17-99b4-92ba89672150", "migrations_dir": "migrations" }]
  }
}
