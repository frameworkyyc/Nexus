{
  // Static single-page app served by Cloudflare Workers assets.
  // Production is intentionally not configured yet; deploy only via the staging env.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-staging",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": { "name": "nexus-staging" }
  }
}
