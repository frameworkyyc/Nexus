{
  // Nexus — ONE Cloudflare Worker (`nexus`) with two environments, plus a separate public-demo Worker (wrangler.demo.jsonc).
  //
  //   Branch    Build command      Deploy command         Served at                          Sign-in             Database
  //   main      npm run build      npx wrangler deploy    nexus.frameworktools.ca            WorkOS AuthKit      nexus-production   (PRODUCTION: the settings below)
  //   staging   npm run build      npx wrangler preview   staging.nexus.frameworktools.ca    Cloudflare Access   nexus-staging      (Worker Preview: "previews" below)
  //   (demo)    npm run build:demo npx wrangler deploy --config wrangler.demo.jsonc   demo.nexus.frameworktools.ca   none (browser-only fictional data; Worker `nexus-demo`)
  //
  // `wrangler preview` publishes an isolated Preview named after the git branch ("staging"). It never creates a Worker version or deployment on
  // production, and a Preview does NOT inherit the top-level bindings or variables, so staging can never reach the production database or secrets.
  // Domains are managed in the Cloudflare dashboard (not in this file), so a deploy never moves them.
  //
  // The Worker serves only /api/* (saved data and sign-in); static files are served by Cloudflare's asset layer and carry no data (the application bundle
  // compiles in no real identity). Every data route needs a verified sign-in and a membership; docs/AUTH.md and docs/DEPLOYMENT.md have the details.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  // Safety net: `wrangler deploy` builds dist/ itself on a clean clone.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    // Unknown paths return index.html so React Router handles direct URLs and refreshes.
    "not_found_handling": "single-page-application",
    // Only API calls reach the Worker.
    "run_worker_first": ["/api/*"]
  },
  // PRODUCTION (deployed only from main; scripts/guard-production.mjs refuses any other branch). Public, non-secret settings only:
  //   NEXUS_ENV production  turns on the production module locks (Coming Soon) and forces WorkOS sign-in: Cloudflare Access tokens and the local
  //                         development bypass are never accepted here (src/worker/authRoutes.ts).
  //   WORKOS_CLIENT_ID      the public client id of the Nexus WorkOS PRODUCTION environment (never the Staging one).
  //   APP_BASE_URL          this site's origin; the WorkOS redirect, sign-in and sign-out URLs are built from it and must match the WorkOS dashboard exactly.
  // Secrets live in Cloudflare, never here: WORKOS_API_KEY, SESSION_PEPPER and INITIAL_ADMIN_EMAIL (docs/RELEASE-v1.0.md).
  "vars": {
    "NEXUS_ENV": "production",
    "AUTH_PROVIDER": "workos",
    "WORKOS_CLIENT_ID": "client_01M6BZ6XSCEHJM3P69FW4C2T9S",
    "APP_BASE_URL": "https://nexus.frameworktools.ca"
  },
  // The PRODUCTION database only. Staging has its own (see "previews"); never put one's id in the other's section. Migrations are applied by hand with a recovery bookmark
  // (docs/RELEASE-v1.0.md): nothing runs on deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "nexus-production", "database_id": "d3f3ed8d-618b-4f00-82e3-52bfefae1245", "migrations_dir": "migrations" }],
  // Staging (Worker Preview) settings. Never point these at the production database.
  "previews": {
    "vars": {
      "NEXUS_ENV": "staging",
      // From Zero Trust → Access → Applications → (your app). Fill in after creating the Access application.
      "ACCESS_TEAM_DOMAIN": "https://frameworkco-admin.cloudflareaccess.com",
      "ACCESS_AUD": "4026513ce48dab9a17746204c3dff5e2a86400a7db34632ff4f701d805318a2f",
      // First administrator (docs/MATERIALS.md): used only while no administrator exists, and only for a request Cloudflare Access has verified.
      "INITIAL_ADMIN_EMAIL": "hello@frameworkco.ca",
      // Staging signs in with Cloudflare Access only. WorkOS is for production.
      "AUTH_PROVIDER": "access"
    },
    // The STAGING database only. Never put nexus-production here. Migrations 0001-0007 are applied to it (docs/OPERATIONS.md).
    "d1_databases": [{ "binding": "DB", "database_name": "nexus-staging", "database_id": "8efc35c6-e125-4c17-99b4-92ba89672150", "migrations_dir": "migrations" }]
  }
}
