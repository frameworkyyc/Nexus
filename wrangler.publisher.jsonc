{
  // The snapshot publisher (NOT deployed). A private Worker with no public address whose scheduled run keeps the public snapshot current if an update
  // was missed: it reads the staging database (SELECT only, in code) and writes the one sanitized snapshot object to the private R2 bucket.
  //   Deploy once approved:  npx wrangler deploy --config wrangler.publisher.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-publisher",
  "main": "src/worker/publisher.ts",
  "compatibility_date": "2025-09-01",
  // No public address of any kind.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "nexus-staging", "database_id": "8efc35c6-e125-4c17-99b4-92ba89672150" }],
  "r2_buckets": [{ "binding": "PUBLIC_SNAPSHOT", "bucket_name": "nexus-public-snapshot" }]
}
